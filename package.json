{
  "name": "sunsetdnweb",
  "version": "0.0.1",
  "description": "낮밤사이(SunsetDN) 공식 웹사이트",
  "private": true,
  "keywords": [
    "sunsetdn",
    "낮밤사이"
  ],
  "license": "UNLICENSED",
  "author": "SunsetDN(낮밤사이)",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate:pages": "node scripts/generate-index.js && node scripts/generate.js && node scripts/generate-commission.js",
    "build:css": "tailwindcss -c tailwind.config.js -i ./css/tailwind-src.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./css/tailwind-src.css -o ./css/tailwind.css --watch",
    "start": "webpack serve --open --config webpack.config.dev.js",
    "build": "npm run generate:pages && npm run build:css && webpack --config webpack.config.prod.js"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^11.0.0",
    "html-webpack-plugin": "^5.6.0",
    "tailwindcss": "^3.4.17",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "webpack-merge": "^5.10.0"
  }
}
